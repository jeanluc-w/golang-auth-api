<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Reset your password</title>
</head>
<body style="margin: 0; padding: 5px; background-color: #f4f4f4; font-family: Arial, sans-serif;">
  <table cellpadding="0" cellspacing="0" width="100%" bgcolor="#f4f4f4">
    <tr>
      <td align="center">
        <table cellpadding="0" cellspacing="0" width="600" style="background-color: #ffffff; margin: 40px 0; border-radius: 8px;">
          <tr>
            <td style="padding: 30px; color: #333333;">
              <h2>Reset your password</h2>
              <p>We received a request to reset your password. If you didn't make this request, you can safely ignore this email — your password won't change.</p>
              {{if .ResetLink}}
              <table cellpadding="0" cellspacing="0" width="100%" style="margin: 20px 0;">
                <tr>
                  <td align="center">
                    <a href="{{.ResetLink}}" style="display: inline-block; background-color: #000; color: #fff; padding: 14px 28px; text-decoration: none; border-radius: 4px; font-weight: bold;">Reset password</a>
                  </td>
                </tr>
              </table>
              <p>Or use this reset code directly: <strong>{{.Token}}</strong></p>
              {{else}}
              <table cellpadding="0" cellspacing="0" width="100%" style="margin: 20px 0;">
                <tr>
                  <td align="center" style="background-color: #f0f0f0; padding: 20px; font-size: 20px; font-weight: bold; color: #000; word-break: break-all;">
                    {{.Token}}
                  </td>
                </tr>
              </table>
              {{end}}
              <p>This link expires in {{.ExpiresInMinutes}} minutes and can only be used once.</p>
              <p>Thank you!</p>
            </td>
          </tr>
          <tr>
            <td bgcolor="#eeeeee" style="padding: 20px; text-align: center; font-size: 12px; color: #777;">
              ©2026 auth
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
