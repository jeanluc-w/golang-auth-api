DATABASE_URL=postgres://admin:superlongsecretpassword@localhost:5432/auth?sslmode=disable
ENV=development
JWT_PUBLIC_KEY_FILE=./secrets/jwt_public_key.pem
JWT_PRIVATE_KEY_FILE=./secrets/jwt_private_key.pem
JWT_PRIVATE_KEY_PASSPHRASE=some_password
PORT=8080
REDIS_ADDR=localhost:6379
REQUEST_TIMEOUT_SECONDS=10
REQUEST_RATE_LIMIT=10
SENTRY_DSN=GET_FROM_VAULT
SENTRY_SAMPLE_RATE=1.0
RESEND_API_KEY=GET_FROM_VAULT
EMAIL_FROM_ADDRESS=auth <no-reply@mail.auth.com>
PASSWORD_PEPPERS=id1:base64string,id2:base64string # Do something like `openssl rand -base64 16`
ACTIVE_PEPPER_ID=id1
# Comma-separated list of origins allowed to make cross-origin requests
# (e.g. https://app.example.com,https://admin.example.com). In development,
# leaving this empty allows any origin for easier local testing; in every
# other environment it should always be set.
ALLOWED_ORIGINS=
# Failed logins allowed before an account is temporarily locked, and how
# long that lock lasts.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=15
# How long a password reset token/link stays valid after being requested.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Optional: base URL of the frontend's reset-password page, e.g.
# https://app.example.com/reset-password — the reset email links here with
# ?token=<raw token> appended. Leave empty to have the email just state the
# raw token instead (e.g. for a mobile app that deep-links its own way).
PASSWORD_RESET_URL=
# Required: 32 raw bytes, base64-encoded (`openssl rand -base64 32`), used
# to encrypt TOTP secrets at rest (AES-256-GCM). Unlike a password, a TOTP
# secret must be decryptable to verify a code, so it can't just be hashed —
# treat this key with the same care as PASSWORD_PEPPERS.
MFA_ENCRYPTION_KEY=
# Name shown in authenticator apps (Google Authenticator, 1Password, etc.)
# next to the account. Defaults to "auth-api".
MFA_ISSUER=
# Optional: only needed if you're using "Sign in with Google" / "Sign in
# with Apple". Unset means that provider's SSO endpoint responds with a
# clear "not configured" error instead of the service failing to start.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
