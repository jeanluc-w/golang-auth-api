DATABASE_URL=postgres://admin:superlongsecretpassword@localhost:5432/auth?sslmode=disable
ENV=development
JWT_PUBLIC_KEY_FILE=./secrets/jwt_public_key.pem
JWT_PRIVATE_KEY_FILE=./secrets/jwt_private_key.pem
JWT_PRIVATE_KEY_PASSPHRASE=some_password
PORT=8080
REDIS_ADDR=localhost:6379
REQUEST_TIMEOUT_SECONDS=10
REQUEST_RATE_LIMIT=10
SENTRY_DSN=GET_FROM_VAULT
SENTRY_SAMPLE_RATE=1.0
RESEND_API_KEY=GET_FROM_VAULT
EMAIL_FROM_ADDRESS=auth <no-reply@mail.auth.com>
PASSWORD_PEPPERS=id1:base64string,id2:base64string # Do something like `openssl rand -base64 16`
ACTIVE_PEPPER_ID=id1
# Comma-separated list of origins allowed to make cross-origin requests
# (e.g. https://app.example.com,https://admin.example.com). In development,
# leaving this empty allows any origin for easier local testing; in every
# other environment it should always be set.
ALLOWED_ORIGINS=
# Failed logins allowed before an account is temporarily locked, and how
# long that lock lasts.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=15
